generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Activity {
  id                      String   @id
  nama                    String   @default("")
  jenisKegiatan           String   @default("") @map("jenis_kegiatan")
  subKegiatan             String   @default("") @map("sub_kegiatan")
  statusKegiatan          String   @default("") @map("status_kegiatan")
  kasubid                 String   @default("")
  kabid                   String   @default("")
  kasubidKabidBidangLain  String   @default("") @map("kasubid_kabid_bidang_lain")
  sekban                  String   @default("")
  kaban                   String   @default("")
  keteranganTambahan      String   @default("") @map("keterangan_tambahan")
  status                  String   @default("Direncanakan")
  tanggalSelesai          String   @default("") @map("tanggal_selesai")
  dasarRegulasi           String   @default("") @map("dasar_regulasi")
  catatan                 String   @default("")
  link                    String   @default("")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("activities")
}
